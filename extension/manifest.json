{
  "manifest_version": 3,
  "name": "SI GAMES Controller Bridge",
  "version": "1.0.0",
  "description": "Drives a game opened in its own tab with the SI GAMES phone controller pads.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "SI GAMES Controller Bridge",
    "default_popup": "popup.html"
  }
}
